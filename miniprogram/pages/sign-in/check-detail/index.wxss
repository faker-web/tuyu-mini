.root {
  backdrop-filter: blur(32px);
  box-shadow: 0px 4px 15px 0px #DAD9DC;
  border: 1px solid #FFFFFF;
  background: linear-gradient(180deg, rgba(255, 251, 233, 0.45) 0%, rgba(255, 243, 243, 0.81) 100%);
  border-radius: 48rpx;

}
.hongbao {
  position: relative;
  display: inline-block;
}

.hongbao .jifen-text {
  color: #fff;
  position: absolute;
  z-index: 1;
  font-size: 24rpx;
  letter-spacing: 0;
  font-weight: 500;
  bottom: 12rpx;
  left: 0;
  right: 0;
  text-align: center;
}

.check-list {
  display: flex;
  position: relative;
  margin-top: 48rpx;
}

.check-list-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.check-list .line {
  position: absolute;
  left: 2rem;
  right: 2rem;
  bottom: 1.9rem;
  z-index: 0;
  height: 2rpx;
  background-color: #E6E5EA;
}

.sign-in-button {
  background: linear-gradient(180deg, #F76065 0%, #F53137 48.57%, #FD7276 100%);
  color: #fff;
  width: 476rpx;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 64rpx;
  font-size: 40rpx;
  font-weight: 500;
  margin: 0 auto;
  margin-top: 48rpx;
}