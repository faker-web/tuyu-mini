.root {
	border-radius: 32rpx;
	box-shadow: 0px 4px 4px 0px #DAD9DC40;
	background: #fff;
	height: 240rpx;
	position: relative;
	overflow: hidden;

	display: flex;
	align-items: center;
	padding: 0 48rpx;
}


.middle {
	flex: 1;
	padding-left: 24rpx;
}

.title {
	font-family: PingFang SC;
	font-weight: 600;
	font-style: Semibold;
	font-size: 16px;
	line-height: 100%;
	letter-spacing: -0.21px;
	text-transform: capitalize;
}

.desc {
	font-family: PingFang SC;
	font-weight: 400;
	font-style: Regular;
	font-size: 14px;
	line-height: 100%;
	letter-spacing: -0.21px;
	text-transform: capitalize;
	margin-top: 16rpx;
	color: #00000080;
}

.share-button-root {
	flex: 0;
	width: 230rpx;
	background: linear-gradient(272.41deg, rgba(247, 207, 159, 0.5) 1.01%, rgba(249, 218, 176, 0.5) 95.77%);
	border-radius: 40rpx;

}
.share-button {
	display: inline-flex;
	padding: 16rpx 40rpx;
	line-height: 1;
	align-items: center;
	gap: 24rpx;

	width: 80px;
	min-width: 80px;
	background: transparent;

}


