.root {
	border-radius: 32rpx;
	box-shadow: 0px 4px 4px 0px #DAD9DC40;
	
	background: linear-gradient(180deg, #F76065 0%, #F53137 48.57%, #FD7276 100%);

	height: 240rpx;
	position: relative;
	overflow: hidden;
}

.bg-image {
	position: absolute;
	top: 0;
}

.actions {
	position: absolute;
	right: 16rpx;
}

.action-button {
	font-family: PingFang SC;
	font-weight: 400;
	font-style: Regular;
	font-size: 11px;
	line-height: 100%;
	letter-spacing: 0%;
	text-align: center;
	color: #F6464B;

	background: #FEF1F0;
	padding: 4rpx 16rpx;
	line-height: 1;
	display: inline-block;
	border-radius: 32rpx;
}

.head {
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: flex-end;
	margin-right: 100rpx;
}

.head-title {
	font-family: Inter;
	font-weight: 900;
	font-style: Black;
	font-size: 24px;
	line-height: 100%;
	letter-spacing: 0%;
	text-align: center;
	color: #ffffff;

}

.head-title-description {
	font-family: Inter;
	font-weight: 400;
	font-style: Regular;
	font-size: 12px;
	line-height: 100%;
	letter-spacing: 0%;
	text-align: center;
	color: #FFFFFF;
	opacity: 0.8;
	margin-top: 20rpx;
}