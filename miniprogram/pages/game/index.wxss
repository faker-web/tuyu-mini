.container {
  height: 100vh;
  width: 100vw;
}

page {
  overflow: hidden;
  height: 100vh;
  background-color: #fafafa;
}

/* 或者更具体的针对微信的样式 */
.weui-webview__header {
  display: none !important;
}

.bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  background-color: #fde4ba;
}

.bg image {
  position: absolute;
  height: 100vh;
  width: 100vw;
}