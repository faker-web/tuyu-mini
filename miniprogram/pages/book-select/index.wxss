page {
	background: #F0EBDD;
}

.root {
	padding: 16px;
	display: flex;
	gap: 8px;
	flex-wrap: wrap;
}

.book-card {
	border-radius: 4px;
	border: 0.5px solid #0000001F;
	overflow: hidden;
	width: 107px;
	height: 150px;
	position: relative;
}

.book-tips {
	position: absolute;
	bottom: 0;
	height: 24px;
	left: 0;
	right: 0;
	background-color: rgba(0, 0, 0, 0.4);
	color: rgba(255, 255, 255, 0.65);
	font-size: 12px;
	display: flex;
	align-items: center;
	justify-content: center;
}

.page-footer {
	position: fixed;
	left: 0;
	bottom: 0;
  right: 0;
  z-index: 11;
	background-color: #F0EBDD;

	display: flex;
	gap: 16px;

	padding: 10px 16px 42px;
}


.book-radio {
	position: absolute;
  left: 2px;
  top: 2px;
  transform: scale(0.7);
  z-index: 10;
}