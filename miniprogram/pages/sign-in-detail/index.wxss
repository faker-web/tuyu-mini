/* pages/sign-in-detail/index.wxss */
.page {
  background: #f7f7fa;
  min-height: 100vh;
  padding-bottom: 32rpx;
}

.point-list {
  margin-top: 16rpx;
	padding: 0 24rpx;
	
}

.point-item {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx 0 #dad9dc40;
  padding: 32rpx 28rpx 24rpx 28rpx;
  margin-bottom: 24rpx;
	display: flex;
	align-self: center;
}

.point-item-main {
  display: flex;
  /* align-items: center; */
	justify-content: space-between;
	flex: 1;
	flex-direction: column;
}

.point-title {
  font-size: 30rpx;
  color: #222;
  font-weight: 500;
}

.point-value {
  font-size: 32rpx;
	font-weight: bold;
	display: flex;
	align-items: center;
	
}

.point-value.plus {
  color: #c7a35a;
}

.point-value.minus {
  color: #888;
}

.point-time {
  font-size: 24rpx;
  color: #bdbdbd;
  margin-top: 8rpx;
}