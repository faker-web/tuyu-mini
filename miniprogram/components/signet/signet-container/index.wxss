.signet-container {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  min-height: 380px;
}
.signet-container image {
  width: 100%;
  margin: 0 16px;
}

.signet-container-content {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;

  display: flex;
  align-items: center;
  justify-content: center;
}

.signet-container-empty {
  width: 269px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1px dotted #00000033;
  border-radius: 4px;
  padding: 0 0 24px 0;
}

.empty-btn-groups {
  display: flex;
  align-items: center;
  gap: 12px;
  height: 44px;
  margin-top: 24px;
}

.empty-btn-groups .btn {
  width: 106px;
  border: 1px solid #00002240;
  border-radius: 12px;
  height: 100%;
  text-align: center;
  line-height: 44px;
  font-size: 16px;
  color: #000022D9;
}

.finish-icon-container {
  position: absolute;
  right: 50px;
  top: 30px;
}

.switch-button {
  position: absolute;
  right: 62px;
  top: 52px;
  z-index: 10;
}

.width-fix .image {
  width: 200px !important;
}

.height-fix .image {
  height: 200px !important;
}

.signet-image {
  transition:  0.5s;
  transform: scale(1);
}

.signet-image.fetching {
  opacity: 0;
  transform: scale(0.1);
  transition: 0s;
}

.signet-image .image {
  width: 260px;
  height: 260px;
}