.signet-container {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  min-height: 760rpx;
}
.signet-container image {
  width: 100%;
  margin: 0 32rpx;
}

.signet-container-content {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;

  display: flex;
  align-items: center;
  justify-content: center;
}

.signet-container-empty {
  width: 538rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1px dotted #00000033;
  border-radius: 8rpx;
  padding: 0 0 48rpx 0;
}

.empty-btn-groups {
  display: flex;
  align-items: center;
  gap: 24rpx;
  height: 88rpx;
  margin-top: 48rpx;
}

.empty-btn-groups .btn {
  width: 212rpx;
  border: 1px solid #00002240;
  border-radius: 24rpx;
  height: 100%;
  text-align: center;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #000022D9;
}

.finish-icon-container {
  position: absolute;
  right: 100rpx;
  top: 60rpx;
}

.switch-button {
  position: absolute;
  right: 124rpx;
  top: 104rpx;
  z-index: 10;
}

.width-fix .image {
  width: 400rpx !important;
}

.height-fix .image {
  height: 400rpx !important;
}

.signet-image {
  transition:  0.5s;
  transform: scale(1);
}

.signet-image.fetching {
  opacity: 0;
  transform: scale(0.1);
  transition: 0s;
}

.signet-image .image {
  width: 520rpx;
  height: 520rpx;
}

.signet-swiper-container {
  /* height: 100%; */
  min-height: 760rpx;
}