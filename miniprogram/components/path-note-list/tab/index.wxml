<!--components/path-note-list/tab/index.wxml-->
<scroll-view scroll-x style="height: 36px;">
  <view class="flex items-center gap-8 path-notes" >
		<view style="white-space: nowrap;" class="flex items-center relative path-note {{curKey === item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" bindtap="onClick" data-index="{{index}}">
			<view>{{item.icon}}</view>
			<view>{{item.name}}</view>

			<view class="absolute square">
			</view>
		</view>
	</view>
</scroll-view>