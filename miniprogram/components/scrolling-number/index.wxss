/* components/scrolling-number/index.wxss */
.scrolling-number-container {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.digit-wrapper {
  position: relative;
  overflow: hidden;
  height: 1.2em; /* 确保高度足够 */
}

.digit-container {
  position: relative;
  overflow: hidden;
  text-align: center;
  font-weight: bold;
  /* width: 100%; */
  height: 100%;
}

.digit-scroll {
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease-out;
  /* width: 100%; */
  height: 100%;
}

.digit-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  /* width: 100%; */
  height: 100%;
  text-align: center;
  /* font-family: 'Courier New', monospace; */
  font-weight: bold;
  flex-shrink: 0; /* 防止数字被压缩 */
  box-sizing: border-box;
}